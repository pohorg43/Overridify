#!/system/bin/sh

# Системные бинарники Bionic всегда имеют приоритет в PATH
export PATH="/system/bin:/system/xbin:/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH"

if [ "$(id -u)" != "0" ] && command -v su >/dev/null 2>&1; then
    if [ $# -eq 0 ]; then
        exec su -c "$0"
    else
        ARGS=""
        for a in "$@"; do
            ARGS="$ARGS \"$a\""
        done
        exec su -c "$0$ARGS"
    fi
fi

STRINGS_BIN="strings"
if ! command -v strings >/dev/null 2>&1; then
    if toybox strings /system/bin/sh >/dev/null 2>&1; then
        STRINGS_BIN="toybox strings"
    elif [ -f /data/adb/magisk/busybox ]; then
        STRINGS_BIN="/data/adb/magisk/busybox strings"
    elif [ -f /data/adb/ksu/bin/busybox ]; then
        STRINGS_BIN="/data/adb/ksu/bin/busybox strings"
    elif [ -f /data/adb/ap/bin/busybox ]; then
        STRINGS_BIN="/data/adb/ap/bin/busybox strings"
    fi
fi

for cs in /dev/cpuset/top-app /dev/cpuset/foreground /sys/fs/cgroup/top-app; do
    if [ -d "$cs" ]; then
        if [ -w "$cs/cgroup.procs" ]; then
            echo $$ > "$cs/cgroup.procs" 2>/dev/null
        elif [ -w "$cs/tasks" ]; then
            echo $$ > "$cs/tasks" 2>/dev/null
        fi
    fi
done

if [ -f "$(dirname "$0")/../module.prop" ]; then
    MODDIR="$(cd "$(dirname "$0")/.." && pwd)"
elif [ -f "$(dirname "$0")/../../module.prop" ]; then
    MODDIR="$(cd "$(dirname "$0")/../.." && pwd)"
elif [ -d "/data/adb/modules_update/overridify" ]; then
    MODDIR="/data/adb/modules_update/overridify"
elif [ -d "/data/adb/modules/overridify" ]; then
    MODDIR="/data/adb/modules/overridify"
elif [ -d "/data/data/com.termux/files/home/overridify" ]; then
    MODDIR="/data/data/com.termux/files/home/overridify"
else
    MODDIR="/data/adb/modules/overridify"
fi
PROP_FILE="$MODDIR/system.prop"
CFG_LANG="$MODDIR/language.cfg"
SCAN="$MODDIR/bin/overridify-scan"
[ ! -f "$SCAN" ] && [ -f "$MODDIR/system/bin/overridify-scan" ] && SCAN="$MODDIR/system/bin/overridify-scan"
[ ! -f "$SCAN" ] && [ -f "/data/adb/bin/overridify-scan" ] && SCAN="/data/adb/bin/overridify-scan"
[ ! -f "$SCAN" ] && SCAN="/system/bin/overridify-scan"

for d in "$MODDIR" /data/adb/modules_update/overridify /data/adb/modules/overridify /data/data/com.termux/files/home/overridify; do
    if [ -f "$d/common/database/audit_targets.sh" ]; then
        . "$d/common/database/audit_targets.sh"
        break
    fi
done

[ -f "$MODDIR/common/database/hwui.sh" ] && . "$MODDIR/common/database/hwui.sh"
[ -f "$MODDIR/common/database/sf.sh" ] && . "$MODDIR/common/database/sf.sh"
[ -f "$MODDIR/common/database/aosp_reference.sh" ] && . "$MODDIR/common/database/aosp_reference.sh"
for d in "$MODDIR" /data/adb/modules_update/overridify /data/adb/modules/overridify /data/data/com.termux/files/home/overridify; do
    [ -f "$d/common/database/presets.sh" ] && { . "$d/common/database/presets.sh"; break; }
done

# Select best AWK implementation (mawk prioritized)
AWK_BIN="awk"
if [ -x "$MODDIR/bin/mawk" ]; then
    AWK_BIN="$MODDIR/bin/mawk"
elif [ -x "$MODDIR/system/bin/mawk" ]; then
    AWK_BIN="$MODDIR/system/bin/mawk"
elif [ -x /data/adb/modules/overridify/bin/mawk ]; then
    AWK_BIN="/data/adb/modules/overridify/bin/mawk"
elif [ -x /data/adb/modules/overridify/system/bin/mawk ]; then
    AWK_BIN="/data/adb/modules/overridify/system/bin/mawk"
elif command -v mawk >/dev/null 2>&1; then
    AWK_BIN="mawk"
elif [ -x /data/adb/bin/mawk ]; then
    AWK_BIN="/data/adb/bin/mawk"
elif [ -x /data/data/com.termux/files/usr/bin/mawk ]; then
    AWK_BIN="/data/data/com.termux/files/usr/bin/mawk"
elif command -v gawk >/dev/null 2>&1; then
    AWK_BIN="gawk"
elif [ -x "$MODDIR/system/bin/gawk" ]; then
    AWK_BIN="$MODDIR/system/bin/gawk"
elif [ -x /data/adb/modules/overridify/system/bin/gawk ]; then
    AWK_BIN="/data/adb/modules/overridify/system/bin/gawk"
elif [ -x /data/adb/modules/gawk-system/system/bin/gawk ]; then
    AWK_BIN="/data/adb/modules/gawk-system/system/bin/gawk"
elif [ -x /data/data/com.termux/files/usr/bin/gawk ]; then
    AWK_BIN="/data/data/com.termux/files/usr/bin/gawk"
elif [ -x /system/bin/gawk ]; then
    AWK_BIN="/system/bin/gawk"
elif [ -x /data/adb/bin/gawk ]; then
    AWK_BIN="/data/adb/bin/gawk"
fi

RESETPROP_BIN="resetprop"
for rp in resetprop /data/adb/magisk/resetprop /data/adb/ksu/bin/resetprop /data/adb/ap/bin/resetprop; do
    if command -v "$rp" >/dev/null 2>&1 || [ -f "$rp" ]; then RESETPROP_BIN="$rp"; break; fi
done

C_RESET="\033[0m"; C_BOLD="\033[1m"; C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"; C_CYAN="\033[1;36m"; C_RED="\033[1;31m"; C_GRAY="\033[0;90m"

# Очистка видимого экрана И буфера прокрутки (scrollback buffer) терминала
clear() {
    printf "\033[3J\033[H\033[2J"
}

if [ -n "$MODDIR" ] && [ -d "$MODDIR" ] && [ -w "$MODDIR" ]; then
    OVER_CACHE_DIR="$MODDIR/cache"
elif [ -d "/data/adb/modules/overridify" ] && [ -w "/data/adb/modules/overridify" ]; then
    OVER_CACHE_DIR="/data/adb/modules/overridify/cache"
elif [ -w "/data/local/tmp" ] || [ "$(id -u)" = "0" ]; then
    OVER_CACHE_DIR="/data/local/tmp/overridify_cache"
else
    OVER_CACHE_DIR="${TMPDIR:-/data/data/com.termux/files/usr/tmp}/overridify_cache"
fi
OVER_TMP_DIR="$OVER_CACHE_DIR"
CACHE_READY_FILE="$OVER_CACHE_DIR/cache_ready.tmp"
CACHE_READY_FULL_FILE="$OVER_CACHE_DIR/cache_ready_full.tmp"
mkdir -p "$OVER_CACHE_DIR" 2>/dev/null
cleanup_cache() {
    rm -f "$OVER_TMP_DIR"/sc_*.tmp "$OVER_TMP_DIR"/smap_*.tmp "$OVER_TMP_DIR"/sub_*.sorted \
          "$OVER_TMP_DIR"/exp_*.sorted "$OVER_TMP_DIR"/part_*.txt "$OVER_TMP_DIR"/radar_*.tmp \
          "$OVER_TMP_DIR"/radar_cache.txt "$OVER_TMP_DIR"/search_sc.tmp 2>/dev/null
}
trap cleanup_cache EXIT INT TERM HUP

detect_soc() {
    local hw=$(getprop ro.hardware) plat=$(getprop ro.board.platform) mfg=$(getprop ro.soc.manufacturer)
    if echo "$hw $plat $mfg" | grep -qiE "qcom|qti|msm|sm[0-9]|kona|lahaina|taro|kalama|pineapple"; then echo "Qualcomm"
    elif echo "$hw $plat $mfg" | grep -qiE "mt[0-9]|mediatek|dimensity"; then echo "MediaTek"
    else echo "Generic"; fi
}
SOC_TYPE=$(detect_soc)
API=$(getprop ro.build.version.sdk)

detect_oem_os() {
    local op_api=$(getprop ro.build.version.oplus.api) op_ver=$(getprop ro.build.version.oplusrom.display)
    [ -z "$op_ver" ] && op_ver=$(getprop ro.build.version.oplusrom)
    [ -n "$op_api" ] || [ -n "$op_ver" ] && { echo "ColorOS: ${op_ver:-?} (API ${op_api:-?})"; return; }
    local mi_os=$(getprop ro.mi.os.version.name)
    [ -z "$mi_os" ] && mi_os=$(getprop ro.ai.os.version.name)
    local mi_inc=$(getprop ro.mi.os.version.incremental)
    [ -z "$mi_inc" ] && mi_inc=$(getprop ro.build.version.incremental)
    local mi_ui=$(getprop ro.miui.ui.version.name)
    if [ -n "$mi_os" ] || { [ -n "$mi_inc" ] && case "$mi_inc" in OS[0-9]*) true ;; *) false ;; esac; }; then
        local os_disp="${mi_os:-HyperOS}"
        [ -n "$mi_inc" ] && os_disp="$os_disp ($mi_inc)"
        echo "HyperOS: $os_disp"; return
    elif [ -n "$mi_ui" ]; then
        if [ "$mi_ui" = "V816" ]; then
            echo "HyperOS: ${mi_inc:-1.0}"; return
        else
            echo "MIUI: $mi_ui"; return
        fi
    fi
    local sam_ver=$(getprop ro.build.version.oneui)
    [ -n "$sam_ver" ] && { echo "OneUI: $((sam_ver / 10000)).$(((sam_ver % 10000) / 100))"; return; }
    echo ""
}
OEM_INFO=$(detect_oem_os)

ensure_termux_buffer() {
    local t_home="/data/data/com.termux/files/home"
    local t_dir="$t_home/.termux"
    local t_prop="$t_dir/termux.properties"
    local req_rows=10000

    [ ! -d "$t_home" ] && return 0
    [ ! -d "$t_dir" ] && mkdir -p "$t_dir" 2>/dev/null

    local need_reload=0
    local cur_val=""

    if [ -f "$t_prop" ]; then
        cur_val=$(grep -E '^[[:space:]]*terminal-transcript-rows[[:space:]]*=' "$t_prop" 2>/dev/null | tail -n 1 | tr -cd '0-9')
        if [ -z "$cur_val" ] || [ "$cur_val" -lt "$req_rows" ]; then
            if grep -q 'terminal-transcript-rows' "$t_prop" 2>/dev/null; then
                sed -i -E "s/^[#[:space:]]*terminal-transcript-rows[[:space:]]*=.*/terminal-transcript-rows = $req_rows/" "$t_prop" 2>/dev/null
            else
                echo -e "\nterminal-transcript-rows = $req_rows" >> "$t_prop" 2>/dev/null
            fi
            need_reload=1
        fi
    else
        echo "terminal-transcript-rows = $req_rows" > "$t_prop" 2>/dev/null
        need_reload=1
    fi

    if [ "$need_reload" -eq 1 ]; then
        local t_owner=$(stat -c '%u:%g' "$t_home" 2>/dev/null)
        [ -n "$t_owner" ] && chown -R "$t_owner" "$t_dir" 2>/dev/null
        chmod 600 "$t_prop" 2>/dev/null

        if [ -x /data/data/com.termux/files/usr/bin/termux-reload-settings ]; then
            /data/data/com.termux/files/usr/bin/termux-reload-settings >/dev/null 2>&1
        else
            am broadcast --user 0 -a "com.termux.app.reload_style" "com.termux" >/dev/null 2>&1
        fi
    fi
}

# Гарантированное наличие полного кэша ELF бинарников (с персистентным хранением в MODDIR)
ensure_elf_cache() {
    local elf_cache="$OVER_TMP_DIR/cache_elf_scan.tmp"
    local elf_sig_f="$OVER_TMP_DIR/elf_scan.sig"
    local scan_sig=$(stat -c '%Y:%s' "$SCAN" 2>/dev/null)
    local targets_sig=$(stat -c '%Y:%s' "$MODDIR/common/database/audit_targets.sh" 2>/dev/null)
    local mod_ver="v1.5"
    [ -f "$MODDIR/module.prop" ] && mod_ver=$(grep -m 1 '^version=' "$MODDIR/module.prop" 2>/dev/null | cut -d= -f2)
    local mods_hash=$(cat "$OVER_TMP_DIR/mods.sig" 2>/dev/null | md5sum 2>/dev/null | awk '{print $1}')
    [ -z "$mods_hash" ] && mods_hash=$(cat "$OVER_TMP_DIR/mods.sig" 2>/dev/null | tr '\n' '_')
    local cur_elf_sig="$(getprop ro.build.fingerprint)_${mod_ver}_${scan_sig}_${targets_sig}_${mods_hash}"

    if [ -s "$elf_cache" ] && [ "$cur_elf_sig" = "$(cat "$elf_sig_f" 2>/dev/null)" ]; then
        return 0
    fi

    local persist_elf="$OVER_CACHE_DIR/elf_scan.cache"
    [ ! -w "$OVER_CACHE_DIR" ] && persist_elf=""
    if [ -n "$persist_elf" ] && [ -s "$persist_elf" ]; then
        local cached_sig=$(head -n 1 "$persist_elf" 2>/dev/null | cut -d' ' -f3)
        if [ "$cached_sig" = "$cur_elf_sig" ]; then
            tail -n +2 "$persist_elf" > "$elf_cache" 2>/dev/null
            echo "$cur_elf_sig" > "$elf_sig_f"
            return 0
        fi
    elif [ -s "$MODDIR/elf_scan.cache" ]; then
        local cached_sig=$(head -n 1 "$MODDIR/elf_scan.cache" 2>/dev/null | cut -d' ' -f3)
        if [ "$cached_sig" = "$cur_elf_sig" ]; then
            tail -n +2 "$MODDIR/elf_scan.cache" > "$elf_cache" 2>/dev/null
            echo "$cur_elf_sig" > "$elf_sig_f"
            [ -n "$persist_elf" ] && cp -f "$MODDIR/elf_scan.cache" "$persist_elf" 2>/dev/null
            return 0
        fi
    fi

    local all_elf_bins=""
    [ -f "$OVER_TMP_DIR/cache_all_bins.tmp" ] && all_elf_bins=$(cat "$OVER_TMP_DIR/cache_all_bins.tmp" 2>/dev/null)
    [ -z "$all_elf_bins" ] && type get_all_target_bins >/dev/null 2>&1 && all_elf_bins=$(get_all_target_bins)
    if [ -f "$SCAN" ] && [ -n "$all_elf_bins" ]; then
        "$SCAN" "." $all_elf_bins > "$elf_cache" 2>/dev/null
        echo "$cur_elf_sig" > "$elf_sig_f"
        if [ -n "$persist_elf" ] && [ -s "$elf_cache" ]; then
            { echo "# SIG: $cur_elf_sig"; cat "$elf_cache"; } > "$persist_elf" 2>/dev/null
        fi
    fi
}

_INIT_CACHE_RUNNING=0
_INIT_RADAR_RUNNING=0

ensure_radar_cache() {
    [ "$_INIT_RADAR_RUNNING" -eq 1 ] && return 0
    _INIT_RADAR_RUNNING=1
    local persist_rbin="$OVER_CACHE_DIR/radar_bins.cache"
    local rbin_cache="$OVER_TMP_DIR/cache_radar_bins_in.tmp"
    local rbin_sig_f="$OVER_TMP_DIR/radar_bins.sig"
    if [ -s "$persist_rbin" ] && [ -s "$rbin_cache" ] && [ -f "$rbin_sig_f" ]; then
        local cached_sig=$(head -n 1 "$persist_rbin" 2>/dev/null | cut -d' ' -f3)
        if [ "$cached_sig" = "$(cat "$rbin_sig_f" 2>/dev/null)" ]; then
            _INIT_RADAR_RUNNING=0
            return 0
        fi
    fi
    scan_and_print_junk 1 >/dev/null 2>&1
    _INIT_RADAR_RUNNING=0
}

init_cache() {
    mkdir -p "$OVER_TMP_DIR" 2>/dev/null

    GLOBAL_BOOT_TIME=$($AWK_BIN '/btime/ {print $2}' /proc/stat 2>/dev/null || echo 0)
    CACHE_MODS="$OVER_TMP_DIR/cache_mods.tmp"
    CACHE_SCRIPTS="$OVER_TMP_DIR/cache_scripts.tmp"
    CACHE_BUILDPROP="$OVER_TMP_DIR/cache_buildprop.tmp"
    CACHE_INIT_RC="$OVER_TMP_DIR/cache_init_rc.tmp"
    CACHE_PERSIST="$OVER_TMP_DIR/cache_persist.tmp"
    CACHE_LIVE_PROPS="$OVER_TMP_DIR/cache_live_props.tmp"
    CACHE_LIFECYCLE="$OVER_TMP_DIR/cache_lifecycle.tmp"
    CACHE_FRAMEWORK="$OVER_TMP_DIR/cache_framework.tmp"
    CACHE_DEX_DEFAULTS="$OVER_TMP_DIR/cache_dex_defaults.tmp"
    CACHE_JUNK="$OVER_TMP_DIR/cache_junk.tmp"

    # Уровень 3 (RAM): Всегда актуальный снимок live getprop (выполняется синхронно за ~30-40 мс)
    getprop | tr -d '[]' | $AWK_BIN -F': ' '{print $1 "=" $2}' > "$CACHE_LIVE_PROPS" 2>/dev/null

    [ -f "$CACHE_READY_FULL_FILE" ] && return 0
    [ -n "$PID_CACHE_FW" ] && return 0
    _INIT_CACHE_RUNNING=1
    (
        local t_init_start=$(date +%s.%N)
        local mod_ver="v1.5"
        [ -f "$MODDIR/module.prop" ] && mod_ver=$(grep -m 1 '^version=' "$MODDIR/module.prop" 2>/dev/null | cut -d= -f2)
        local boot_sig="${GLOBAL_BOOT_TIME}_$(getprop ro.build.fingerprint)_${mod_ver}"
        local old_boot_sig=""
        [ -f "$OVER_TMP_DIR/boot.sig" ] && old_boot_sig=$(cat "$OVER_TMP_DIR/boot.sig" 2>/dev/null)

        local fw_roots=""
        for d in /*; do
            [ -d "$d" ] || continue
            case "$d" in
                /proc|/sys|/dev|/data|/data_mirror|/storage|/sdcard|/mnt|/apex|/config|/metadata|/lost+found|/tmp|/linkerconfig|/bugreports|/debug_ramdisk|/bootstrap-apex)
                    continue ;;
                *)
                    fw_roots="$fw_roots $d" ;;
            esac
        done

        local apex_roots=""
        for a in /apex/*; do
            [ -d "$a" ] || continue
            case "$a" in *@*) continue ;; esac
            apex_roots="$apex_roots $a"
        done

        local rsc_vnd=$(getprop ro.vendor.vnd.current_rsc_path 2>/dev/null)
        local rsc_sys=$(getprop ro.sys.current_rsc_path 2>/dev/null)
        local cust_reg=$(getprop ro.miui.region 2>/dev/null | tr A-Z a-z)
        [ -z "$cust_reg" ] && cust_reg=$(getprop persist.sys.country 2>/dev/null | tr A-Z a-z)

        local bp_list=$(find $fw_roots -maxdepth 5 \( -name "*.prop" -o -name "*default.prop" -o -name "*prop.default" \) ! -path "*/cust/*/*" ! -path "*/etc/rsc/*/*" 2>/dev/null)

        for rsc in "$rsc_vnd" "$rsc_sys"; do
            [ -n "$rsc" ] && [ -d "$rsc" ] && for rf in "$rsc"/*.prop; do
                [ -f "$rf" ] && bp_list="$bp_list $rf"
            done
        done

        if [ -n "$cust_reg" ]; then
            for cd in /system_ext/cust /product/cust /cust; do
                [ -f "$cd/$cust_reg/cust.prop" ] && bp_list="$bp_list $cd/$cust_reg/cust.prop"
            done
        fi

# Уровень 3 (RAM): Полный охват жизненного цикла для live, build.prop, persist и модулей
        (
            if [ -f "$MODDIR/common/database/aosp_reference.awk" ] || [ -f "$MODDIR/common/database/aosp_reference.sh" ] || type get_prop_lifecycle >/dev/null 2>&1; then
                local ref_sig=""
                if [ -f "$MODDIR/common/database/aosp_reference.awk" ]; then
                    ref_sig=$(stat -c '%Y:%s' "$MODDIR/common/database/aosp_reference.awk" 2>/dev/null)
                elif [ -f "$MODDIR/common/database/aosp_reference.sh" ]; then
                    ref_sig=$(stat -c '%Y:%s' "$MODDIR/common/database/aosp_reference.sh" 2>/dev/null)
                fi
                local old_ref_sig=""
                [ -f "$OVER_TMP_DIR/ref.sig" ] && old_ref_sig=$(cat "$OVER_TMP_DIR/ref.sig" 2>/dev/null)
                if [ "$ref_sig" != "$old_ref_sig" ] || [ ! -f "$CACHE_LIFECYCLE" ]; then
                    > "$CACHE_LIFECYCLE"
                    echo "$ref_sig" > "$OVER_TMP_DIR/ref.sig"
                fi

                # Собираем кандидатов из ВСЕХ источников: getprop, build.prop, модули, persist
                (
                    $AWK_BIN -F= '{ if ($1 != "") print $1 }' "$CACHE_LIVE_PROPS" 2>/dev/null
                    $AWK_BIN -F= '{ if ($1 ~ /^[a-zA-Z0-9_.-]+$/) print $1 }' /data/adb/modules/*/system.prop 2>/dev/null
                    [ -f "$CACHE_PERSIST" ] && cat "$CACHE_PERSIST" 2>/dev/null
                    [ -n "$bp_list" ] && $AWK_BIN -F= '!/^[[:space:]]*#/ && /=/ { sub(/^[[:space:]]+/, "", $1); sub(/[[:space:]]+$/, "", $1); if ($1 != "") print $1 }' $bp_list 2>/dev/null
                ) | $AWK_BIN -v lc_f="$CACHE_LIFECYCLE" -v cand_f="$OVER_TMP_DIR/lc_delta.tmp" '
                BEGIN {
                    while ((getline l < lc_f) > 0) {
                        c = index(l, ":"); if (c > 1) done[substr(l, 1, c - 1)] = 1;
                    }
                    close(lc_f);
                }
                !/^(init\.svc|ro\.boottime)/ && /^[a-zA-Z0-9_.-]+$/ {
                    if (!done[$1] && !seen[$1]++) {
                        if ($1 ~ /(dolby|aac_drc|composition|pipeline|qam|boost|isa|variant|wm\.|hwui\.|renderengine\.|sf\.|surface_flinger\.|display\.|gralloc\.|af\.|aaudio\.|audio\.|bluetooth\.|bt\.|perf\.|framepacing|input\.resample|oplus\.audio|oplus\.display|enable_mtk_adsp_dump|camera\.privileged)/) {
                            print $1 > cand_f;
                        } else {
                            print $1 ":::" >> lc_f;
                        }
                    }
                }' 2>/dev/null

                if [ -s "$OVER_TMP_DIR/lc_delta.tmp" ]; then
                    local awk_ref=""
                    for d in "$MODDIR" /data/adb/modules/overridify /data/data/com.termux/files/home/overridify; do
                        [ -f "$d/common/database/aosp_reference.awk" ] && { awk_ref="$d/common/database/aosp_reference.awk"; break; }
                    done
                    if [ -n "$awk_ref" ]; then
                        $AWK_BIN -v api="$API" -f "$awk_ref" "$OVER_TMP_DIR/lc_delta.tmp" >> "$CACHE_LIFECYCLE" 2>/dev/null
                    else
                        while IFS= read -r p; do
                            [ -z "$p" ] && continue
                            resolve_prop_lifecycle "$p" "$API"
                            printf "%s:%s\n" "$p" "${RET_META:-:::}"
                        done < "$OVER_TMP_DIR/lc_delta.tmp" >> "$CACHE_LIFECYCLE" 2>/dev/null
                    fi
                fi
                rm -f "$OVER_TMP_DIR/lc_delta.tmp"
            fi
            [ -n "$OVERRIDIFY_BENCH" ] && $AWK_BIN -v ts="$t_init_start" -v tn="$(date +%s.%N)" 'BEGIN { printf "[DEBUG-INIT] c1 done in %.0fms\n", (tn-ts)*1000 }'
        ) &
        local pid_c1=$!
        # Уровень 2 (Модули): Пересборка только если изменились файлы в /data/adb/modules
        (
            local mods_sig=$(stat -c '%n:%Y:%s' /data/adb/modules/* /data/adb/modules/*/module.prop /data/adb/modules/*/system.prop /data/adb/modules/*/disable /data/adb/modules/*/remove /data/adb/modules/*/*.sh /data/adb/modules/*/*/*.sh 2>/dev/null)
            local old_mods_sig=""
            [ -f "$OVER_TMP_DIR/mods.sig" ] && old_mods_sig=$(cat "$OVER_TMP_DIR/mods.sig" 2>/dev/null)
            if [ "$mods_sig" != "$old_mods_sig" ] || [ ! -f "$CACHE_MODS" ]; then
                rm -f "$OVER_TMP_DIR/mod_info.tmp" "$OVER_TMP_DIR/raw_props.tmp" "$CACHE_MODS" "$CACHE_SCRIPTS"
                local dis_mods=" "
                for m in /data/adb/modules/*; do
                    [ ! -d "$m" ] && continue
                    case "$m" in */overridify) continue ;; esac
                    [ -f "$m/remove" ] && continue
                    local mbase="${m##*/}" mstatus=""
                    if [ -f "$m/disable" ]; then
                        local dtime=$(stat -c %Y "$m/disable" 2>/dev/null || echo 0)
                        if [ "$dtime" -lt "$GLOBAL_BOOT_TIME" ]; then dis_mods="$dis_mods$mbase "; continue
                        else mstatus=" [disabled, pending reboot]"; fi
                    fi
                    local mname=""
                    if [ -f "$m/module.prop" ]; then
                        while IFS='=' read -r mk mv; do
                            case "$mk" in *name) mname="$mv"; break ;; esac
                        done < "$m/module.prop" 2>/dev/null
                    fi
                    echo "$mbase|${mname:-$mbase}$mstatus" >> "$OVER_TMP_DIR/mod_info.tmp"
                done
                $AWK_BIN -F= -v dis="$dis_mods" '
                BEGIN { split(dis, da, " "); for (i in da) disabled[da[i]] = 1; }
                FNR == 1 { split(FILENAME, parts, "/"); mod_id = parts[5]; skip = (mod_id in disabled || mod_id == "overridify"); }
                !skip && /^[[:space:]]*[^#[:space:]]/ && /=/ {
                    k = $1; sub(/^[[:space:]]+/, "", k); sub(/[[:space:]]+$/, "", k);
                    v = $2; sub(/^[[:space:]]+/, "", v); sub(/[[:space:]]+$/, "", v); sub(/\r/, "", v);
                    if (k != "") print k "=" v "|" mod_id;
                }' /data/adb/modules/*/system.prop >> "$OVER_TMP_DIR/raw_props.tmp" 2>/dev/null

                [ -f "$OVER_TMP_DIR/mod_info.tmp" ] && [ -f "$OVER_TMP_DIR/raw_props.tmp" ] && $AWK_BIN -F'|' '
                NR == FNR { info[$1] = $2; next }
                {
                    split($0, a, "|"); split(a[1], kv, "="); mid = a[2];
                    mdesc = (mid in info) ? info[mid] : mid;
                    print kv[1] "=" kv[2] "|module (" mdesc ")";
                }' "$OVER_TMP_DIR/mod_info.tmp" "$OVER_TMP_DIR/raw_props.tmp" > "$CACHE_MODS" 2>/dev/null

                grep -H -E '(resetprop|setprop)' /data/adb/modules/*/*.sh /data/adb/modules/*/*/*.sh 2>/dev/null | grep -v '^[[:space:]]*#' | $AWK_BIN -F':' -v dis="$dis_mods" '
                BEGIN { split(dis, da, " "); for (i in da) disabled[da[i]] = 1; }
                { split($1, parts, "/"); mod_id = parts[5]; if (!(mod_id in disabled) && mod_id != "overridify") print $2 "|" mod_id; }' > "$CACHE_SCRIPTS" 2>/dev/null
                echo "$mods_sig" > "$OVER_TMP_DIR/mods.sig"
            fi
            [ -n "$OVERRIDIFY_BENCH" ] && $AWK_BIN -v ts="$t_init_start" -v tn="$(date +%s.%N)" 'BEGIN { printf "[DEBUG-INIT] c2 done in %.0fms\n", (tn-ts)*1000 }'
        ) &
        local pid_c2=$!

        # Уровень 2 (Persist): Пересборка только если изменился /data/property/persistent_properties
        (
            if [ -f "/data/property/persistent_properties" ]; then
                local per_sig=$(stat -c '%Y:%s' /data/property/persistent_properties 2>/dev/null)
                local old_per_sig=""
                [ -f "$OVER_TMP_DIR/persist.sig" ] && old_per_sig=$(cat "$OVER_TMP_DIR/persist.sig" 2>/dev/null)
                if [ "$per_sig" != "$old_per_sig" ] || [ ! -f "$CACHE_PERSIST" ]; then
                    $STRINGS_BIN /data/property/persistent_properties 2>/dev/null | grep -o 'persist\.[a-zA-Z0-9_.-]*' | sort -u > "$CACHE_PERSIST"
                    echo "$per_sig" > "$OVER_TMP_DIR/persist.sig"
                fi
            fi
            [ -n "$OVERRIDIFY_BENCH" ] && $AWK_BIN -v ts="$t_init_start" -v tn="$(date +%s.%N)" 'BEGIN { printf "[DEBUG-INIT] c3 done in %.0fms\n", (tn-ts)*1000 }'
        ) &
        local pid_c3=$!

        # Уровень 1 (Список всех исполняемых файлов и библиотек + ELF сканирование)
        (
            if [ "$boot_sig" != "$old_boot_sig" ] || [ ! -f "$OVER_TMP_DIR/cache_all_bins.tmp" ]; then
                {
                    type get_all_target_bins >/dev/null 2>&1 && get_all_target_bins
                    type get_all_target_jars >/dev/null 2>&1 && get_all_target_jars
                    local scan_dirs=""
                    for root in $fw_roots $apex_roots; do
                        [ ! -d "$root" ] && continue
                        for sub in bin bin/hw system/bin product/bin product/bin/hw lib64 system/lib64 product/lib64 lib system/lib; do
                            [ -d "$root/$sub" ] && scan_dirs="$scan_dirs $root/$sub"
                        done
                        case "$root" in /apex/*)
                            for asub in priv-app app; do
                                [ -d "$root/$asub" ] && scan_dirs="$scan_dirs $root/$asub"
                            done
                            ;;
                        esac
                    done
                    [ -n "$scan_dirs" ] && find $scan_dirs -maxdepth 3 \( -name "*.so" -o -name "*.apk" -o -type f \) 2>/dev/null
                } > "$OVER_TMP_DIR/cache_all_bins.tmp" 2>/dev/null
            fi
            ensure_elf_cache
            [ -n "$OVERRIDIFY_BENCH" ] && $AWK_BIN -v ts="$t_init_start" -v tn="$(date +%s.%N)" 'BEGIN { printf "[DEBUG-INIT] elf done in %.0fms\n", (tn-ts)*1000 }'
        ) &
        local pid_elf=$!

        # Уровень 1 (Статика загрузки: build.prop и init.rc): Собирается 1 раз за сессию загрузки
        (
            if [ "$boot_sig" != "$old_boot_sig" ] || [ ! -f "$CACHE_BUILDPROP" ] || [ ! -f "$CACHE_INIT_RC" ] || [ ! -s "$OVER_TMP_DIR/cache_selinux_roots.tmp" ] || [ ! -f "$OVER_TMP_DIR/cache_rc_alive.tmp" ]; then
                [ -n "$bp_list" ] && $AWK_BIN '
                FNR == 1 { split(FILENAME, parts, "/"); part = parts[2]; fname = parts[length(parts)]; }
                /^[[:space:]]*[^#[:space:]]/ && /=/ {
                    sub(/\r$/, ""); idx = index($0, "=");
                    k = substr($0, 1, idx - 1); v = substr($0, idx + 1);
                    sub(/^[[:space:]]+/, "", k); sub(/[[:space:]]+$/, "", k);
                    sub(/^[[:space:]]+/, "", v); sub(/[[:space:]]+$/, "", v);
                    if (k != "") print k "=" v "|" part " (" fname ")";
                }' $bp_list > "$CACHE_BUILDPROP" 2>/dev/null

                > "$OVER_TMP_DIR/cache_rc_alive.tmp"
                local rc_list=$(find /init*.rc $fw_roots $apex_roots -maxdepth 4 -name "*.rc" 2>/dev/null)
                [ -n "$rc_list" ] && $AWK_BIN -v rc_out="$CACHE_INIT_RC" -v alive_rc="$OVER_TMP_DIR/cache_rc_alive.tmp" '
                /^[[:space:]]*#/ { next }
                /^[[:space:]]*setprop[[:space:]]+/ {
                    print FILENAME ":1:" $0 > rc_out;
                }
                /property:/ {
                    s = $0;
                    while (match(s, /property:[a-zA-Z0-9_.-]+/)) {
                        p = substr(s, RSTART + 9, RLENGTH - 9);
                        if (!seen[p]++) print p >> alive_rc;
                        s = substr(s, RSTART + RLENGTH);
                    }
                }
                /\$\{[a-zA-Z0-9_.-]+\}/ {
                    s = $0;
                    while (match(s, /\$\{[a-zA-Z0-9_.-]+\}/)) {
                        p = substr(s, RSTART + 2, RLENGTH - 3);
                        if (!seen[p]++) print p >> alive_rc;
                        s = substr(s, RSTART + RLENGTH);
                    }
                }' $rc_list 2>/dev/null

                # Индексация читателей из shell-скриптов по всем разделам Android
                local sh_list=$(find $fw_roots -maxdepth 5 -type f -name "*.sh" 2>/dev/null)
                [ -n "$sh_list" ] && $AWK_BIN '
                /getprop/ {
                    s = $0;
                    while (match(s, /getprop[[:space:]]+["\x27]?([a-zA-Z0-9_.-]+)/)) {
                        sub(/.*getprop[[:space:]]+["\x27]?/, "", s);
                        match(s, /^[a-zA-Z0-9_.-]+/);
                        p = substr(s, 1, RLENGTH);
                        if (p ~ /^[a-zA-Z0-9_.-]+\.[a-zA-Z0-9_.-]+$/) print p;
                        s = substr(s, RLENGTH + 1);
                    }
                }
                {
                    n = split($0, a, /["\x27]/);
                    for (i = 2; i <= n; i += 2) {
                        v = a[i];
                        if (v ~ /^[a-zA-Z][a-zA-Z0-9_-]*(\.[a-zA-Z0-9_-]+)+[_.-]?$/) {
                            if (index(v, ".") > 0) print v;
                        }
                    }
                }' $sh_list 2>/dev/null >> "$OVER_TMP_DIR/cache_rc_alive.tmp"
                sort -u -o "$OVER_TMP_DIR/cache_rc_alive.tmp" "$OVER_TMP_DIR/cache_rc_alive.tmp" 2>/dev/null

                # Извлекаем легитимные корни пространств имён строго из системного SELinux прошивки
                local se_list=$(find $fw_roots -maxdepth 4 -name "*property_contexts" 2>/dev/null)
                [ -n "$se_list" ] && $AWK_BIN '!/^[[:space:]]*#/ && NF >= 2 && $1 ~ /^[a-z][a-z0-9_-]*\./ {
                    split($1, a, ".");
                    if (a[1] != "" && !seen[a[1]]++) print a[1];
                }' $se_list 2>/dev/null > "$OVER_TMP_DIR/cache_selinux_roots.tmp"
                echo "$boot_sig" > "$OVER_TMP_DIR/boot.sig"
            fi
            [ -n "$OVERRIDIFY_BENCH" ] && $AWK_BIN -v ts="$t_init_start" -v tn="$(date +%s.%N)" 'BEGIN { printf "[DEBUG-INIT] c4 done in %.0fms\n", (tn-ts)*1000 }'
        ) &
        local pid_c4=$!

        # Уровень 1 (DEX):
        local persist_cache_file="$OVER_CACHE_DIR/dex_framework.cache"
        [ ! -w "$OVER_CACHE_DIR" ] && persist_cache_file="$OVER_TMP_DIR/dex_framework.cache"
        local targets_sig=$(stat -c '%Y:%s' "$MODDIR/common/database/audit_targets.sh" 2>/dev/null)
        local cur_fp="$(getprop ro.build.fingerprint)_$(stat -c %Y /system/framework/services.jar 2>/dev/null)_$(stat -c %Y "$SCAN" 2>/dev/null)_${targets_sig}_${mod_ver}"
        local cached_fp=""
        if [ -f "$persist_cache_file" ]; then
            cached_fp=$(head -n 1 "$persist_cache_file" 2>/dev/null | cut -d' ' -f3)
        elif [ -f "$MODDIR/dex_framework.cache" ]; then
            cached_fp=$(head -n 1 "$MODDIR/dex_framework.cache" 2>/dev/null | cut -d' ' -f3)
            [ -w "$OVER_CACHE_DIR" ] && cp -f "$MODDIR/dex_framework.cache" "$persist_cache_file" 2>/dev/null
        fi

        if [ -n "$cached_fp" ] && [ "$cached_fp" = "$cur_fp" ]; then
            if [ ! -f "$CACHE_DEX_DEFAULTS" ] || [ ! -f "$CACHE_FRAMEWORK" ]; then
                cp "$persist_cache_file" "$CACHE_DEX_DEFAULTS" 2>/dev/null
                $AWK_BIN '!/^#/ {
                    eq = index($0, "="); pipe = match($0, /\|[^|]*$/);
                    if (eq > 0 && pipe > eq) print substr($0, 1, eq - 1) "|" substr($0, pipe + 1);
                }' "$CACHE_DEX_DEFAULTS" > "$CACHE_FRAMEWORK" 2>/dev/null
            fi
        elif [ -f "$SCAN" ]; then
            local fw_jars="$(get_all_target_jars)"
            echo "# FINGERPRINT: $cur_fp" > "$CACHE_DEX_DEFAULTS"
            "$SCAN" --dex $fw_jars 2>/dev/null | $AWK_BIN '
            {
                eq = index($0, "=");
                if (eq > 0) {
                    p = substr($0, 1, eq - 1);
                    val = substr($0, eq + 1);
                    # Иерархия точности дефолтов:
                    # 1) Явный константный дефолт (DEFAULT_*) всегда бьет DYNAMIC_SETTER / NO_DEFAULT / DYNAMIC_DEFAULT
                    # 2) DYNAMIC_DEFAULT бьет DYNAMIC_SETTER / NO_DEFAULT
                    # 3) Непустая строка DEFAULT_STR бьет пустую DEFAULT_STR: ""
                    # 4) Неотрицательный DEFAULT_INT (0, 1...) бьет сигнальный код ошибки DEFAULT_INT: -1
                    if (!(p in best)) {
                        best[p] = val;
                    } else if (best[p] ~ /^(DYNAMIC_SETTER|NO_DEFAULT)/ && val ~ /^(DEFAULT_|DYNAMIC_DEFAULT)/) {
                        best[p] = val;
                    } else if (best[p] ~ /^DYNAMIC_DEFAULT/ && val ~ /^DEFAULT_/) {
                        best[p] = val;
                    } else if (best[p] ~ /^DEFAULT_STR:[[:space:]]*""/ && val ~ /^DEFAULT_STR:[[:space:]]*"[^"]+"/) {
                        if (best[p] !~ /\.jar$/ || val ~ /\.jar$/) {
                            best[p] = val;
                        }
                    } else if (best[p] ~ /^DEFAULT_INT:[[:space:]]*-1(\||$)/ && val ~ /^DEFAULT_INT:[[:space:]]*[0-9]+(\||$)/) {
                        best[p] = val;
                    }
                }
            }
            END {
                for (p in best) print p "=" best[p];
            }' >> "$CACHE_DEX_DEFAULTS" 2>/dev/null
            $AWK_BIN '!/^#/ {
                eq = index($0, "="); pipe = match($0, /\|[^|]*$/);
                if (eq > 0 && pipe > eq) print substr($0, 1, eq - 1) "|" substr($0, pipe + 1);
            }' "$CACHE_DEX_DEFAULTS" > "$CACHE_FRAMEWORK" 2>/dev/null
            cp "$CACHE_DEX_DEFAULTS" "$persist_cache_file" 2>/dev/null
        fi
        [ -n "$OVERRIDIFY_BENCH" ] && $AWK_BIN -v ts="$t_init_start" -v tn="$(date +%s.%N)" 'BEGIN { printf "[DEBUG-INIT] dex done in %.0fms\n", (tn-ts)*1000 }'

        wait "$pid_c1" "$pid_c2" "$pid_c3" "$pid_c4" "$pid_elf" 2>/dev/null
        [ -n "$OVERRIDIFY_BENCH" ] && $AWK_BIN -v ts="$t_init_start" -v tn="$(date +%s.%N)" 'BEGIN { printf "[DEBUG-INIT] all workers waited in %.0fms\n", (tn-ts)*1000 }'
        touch "$CACHE_READY_FILE" 2>/dev/null

        ensure_radar_cache >/dev/null 2>&1
        touch "$CACHE_READY_FULL_FILE" 2>/dev/null
        [ -n "$OVERRIDIFY_BENCH" ] && $AWK_BIN -v ts="$t_init_start" -v tn="$(date +%s.%N)" 'BEGIN { printf "[DEBUG-INIT] full audit cache ready in %.0fms\n", (tn-ts)*1000 }'
    ) &
    PID_CACHE_FW=$!
    _INIT_CACHE_RUNNING=0
}
wait_fw_cache() {
    [ -f "$CACHE_READY_FULL_FILE" ] && return 0
    if [ -n "$PID_CACHE_FW" ]; then
        wait "$PID_CACHE_FW" 2>/dev/null
        PID_CACHE_FW=""
        touch "$CACHE_READY_FILE" "$CACHE_READY_FULL_FILE" 2>/dev/null
    fi
}

api_to_ver() {
    case "$1" in
        14|15) echo "4.0" ;; 16|17|18) echo "4.x" ;; 19|20) echo "4.4" ;;
        21|22) echo "5.0" ;; 23) echo "6.0" ;; 24|25) echo "7.0" ;;
        26) echo "8.0" ;; 27) echo "8.1" ;; 28) echo "9.0" ;; 29) echo "10" ;;
        30) echo "11" ;; 31|32) echo "12" ;; 33) echo "13" ;; 34) echo "14" ;;
        35) echo "15" ;; 36) echo "16" ;;
        *) echo "" ;;
    esac
}

