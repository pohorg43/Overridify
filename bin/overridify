    TXT_IMPORT_SUCCESS="[+] Preset \"%s\" successfully imported!"
    TXT_IMPORT_PACK_SUCCESS="[+] Successfully imported pack of %d presets!"
    TXT_IMPORT_NOT_IN_ROM_WARN="[i] Preset contains %d flag(s) not found in your ROM binaries."
